pipeline{
    agent any 
    stages{
        stage('CHECKOUT'){
            steps{
                git branch:'main',
                url: 'https://github.com/practical-tutorials/project-based-learning.git'
                sh 'ls -lrt'
                }
            }
            stage('BUILD'){
                steps{
                    echo "Your have successfully checkedout to git"
                }
        }
        stage('TESTCASES'){
            parallel{
                stage('TEST1'){
                    steps{
                        echo "Initiated the TEST"
                    }
                }
                stage('TEST2'){
                    steps{
                        sh 'pwd'
                        sh 'ls -lrt'
                        sh 'sleep 5'
                    }
                }
                stage('TEST3'){
                    steps{
                        echo "SUCCESSFULLY TESTED ALL THE CASES"
                    }
                }
            }
        }
        stage("DEPLOY"){
            steps{
                echo 'Execution Completed'
            }
        }
    }
}