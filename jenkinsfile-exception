pipeline{
    agent any 
    stages{
        stage('BUILD'){
            steps{
                catchError(
                    buildResult: 'Failure',
                     stageResult: 'Failure'
                     )
             {
                    echo "Starting Build..."
                    sh 'exit 1'
                    echo "Build completed"
                }
            }
        }
        stage('EXCEPTION_HADLING'){
            steps{
                script{
                    try{
                        sh 'exit 1'
                    }
                    catch (Exception e){
                        echo " caught an exception : ${e.message}"
    
                    }
                    finally{
                        echo "Cleaning up ..."

                    }
                }
            }
        }
        stage('SAMPLE'){
            steps{
                sh ' ls -lrt'
            }
        }
    }
}