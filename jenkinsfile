pipeline {

    agent none

    stages {

        stage('Build') {
            agent {
                label 'slave1'
            }

            steps {
                echo 'Running Build on slave1 Node'

                sh 'echo Building application...'
                sh 'mkdir -p build'
                sh 'echo Build completed > build/result.txt'
            }
        }

        stage('Test') {
            agent {
                label 'slave2'
            }

            steps {
                echo 'Running Tests on slave2 Node'

                sh 'echo Running tests...'
                sh 'cat build/result.txt'
            }
        }

        stage('Deploy') {
            agent any

            steps {
                echo 'Running Deployment on any Node'

                sh 'echo Deploying application...'
                sh 'echo Deployment completed'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}