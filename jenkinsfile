pipeline {

    agent none

    stages {

        stage('Build') {
            agent {
                label 'slave1'
            }

            steps {
                echo 'Running Build on slave1 node'

                sh 'echo Building application...'
                sh 'pwd'
                sh 'ls -lrt'
            }
        }

        stage('Test') {
            agent {
                label 'slave2'
            }

            steps {
                echo 'Running Tests on slave2 node'

                sh 'echo Running tests...'
                sh 'cat jenkinsfile'
            }
        }

        stage('Deploy') {
            agent any

            steps {
                echo 'Running Deployment on Deploy Node'

                sh 'echo Deploying application...'
                sh 'echo Deployment completed'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}
